local autoDropEnabled = false
local autoEquipEnabled = false

-- Функция проверки имени (ищем гранаты и молотовы)
local function matchesTarget(name)
	local lowerName = string.lower(name)
	if string.find(lowerName, "granade") or string.find(lowerName, "grenade") or string.find(lowerName, "molotov") then
		return true
	end
	return false
end

-- Функция проверки на 3 слот (если захочешь прописать название аптечки/хила)
local function isSlot3(name)
	local lower = string.lower(name)
	if string.find(lower, "med") or string.find(lower, "heal") or string.find(lower, "kit") or string.find(lower, "аптеч") then
		return true
	end
	return false
end

-- Функция честного нажатия на клавишу "1"
local function pressKeyOne()
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
	task.wait(0.01)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
end

-- Функция имитации нажатия Backspace для выброса предмета из рук
local function pressBackspaceToDrop(tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	if tool.Parent ~= character then
		humanoid:EquipTool(tool)
		task.wait(0.03)
	end
	
	if tool.Parent == character then
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
		task.wait(0.01)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
		task.wait(0.03)
	end
end

-- Переключатели кнопок
autoDropButton.MouseButton1Click:Connect(function()
	autoDropEnabled = not autoDropEnabled
	if autoDropEnabled then
		autoDropButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		autoDropButton.Text = "Auto-Drop Granade: ON"
	else
		autoDropButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		autoDropButton.Text = "Auto-Drop Granade: OFF"
	end
end)

autoEquipButton.MouseButton1Click:Connect(function()
	autoEquipEnabled = not autoEquipEnabled
	if autoEquipEnabled then
		autoEquipButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		autoEquipButton.Text = "Auto Equip Slot 1: ON"
	else
		autoEquipButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		autoEquipButton.Text = "Auto Equip Slot 1: OFF"
	end
end)

-- Основной мониторинг через Heartbeat
RunService.Heartbeat:Connect(function()
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return end
	
	-- 1. Логика авто-выброса гранат/молотовов
	if autoDropEnabled then
		local foundAnything = false
		
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") and matchesTarget(item.Name) then
				pressBackspaceToDrop(item)
				foundAnything = true
			end
		end
		
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") and matchesTarget(item.Name) then
				pressBackspaceToDrop(item)
				foundAnything = true
			end
		end
		
		if foundAnything then
			pressKeyOne()
		end
	end
	
	-- 2. Логика возврата на 1 слот
	if autoEquipEnabled then
		local currentTool = nil
		for _, item in ipairs(character:GetChildren()) do
			if item:IsA("Tool") then
				currentTool = item
				break
			end
		end
		
		if currentTool then
			local name = currentTool.Name
			-- Если в руках НЕ граната и НЕ 3-й слот (значит, это меч или другое оружие со 2-го слота) — сразу жмем 1
			if not matchesTarget(name) and not isSlot3(name) then
				-- Проверяем, не первое ли это оружие (например, "Golden Pistol" с первой картинки у тебя на 1 слоте, его трогать не нужно)
				local lower = string.lower(name)
				if not string.find(lower, "pistol") and not string.find(lower, "gun") and not string.find(lower, "rifle") then
					pressKeyOne()
				end
			end
		end
	end
end)

-- Кнопка Grab All (подбор)
grabAllButton.MouseButton1Click:Connect(function()
	task.spawn(function()
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj:IsA("Tool") and matchesTarget(obj.Name) then
				local handle = obj:FindFirstChild("Handle")
				if handle then
					local grabPos = hrp.Position + Vector3.new(0, 0.5, 0)
					handle.CFrame = CFrame.new(grabPos)
					task.wait(0.01)
					obj.Parent = player.Backpack
				end
			end
		end
	end)
end)
