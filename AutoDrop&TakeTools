-- Функция проверки имени (ищем гранаты и молотовы — их НЕ трогаем)
local function matchesTarget(name)
	local lowerName = string.lower(name)
	if string.find(lowerName, "granade") or string.find(lowerName, "grenade") or string.find(lowerName, "molotov") then
		return true
	end
	return false
end

-- Проверка: является ли предмет оружием 1-го слота (по твоему полному списку)
local function isSlot1Weapon(name)
	local lower = string.lower(name)
	local weapons = {
		"pistol", "revolver", "uzi", "trench shotgun", "m1 garand", "type 100", 
		"thompson", "sniper", "tactical shotgun", "m16", "scope rifle", "machine gun", 
		"cobra", "blaster", "platinum gun", "toxic", "biohazard", "venom", "ghost", 
		"annihilator", "railgun", "ray gun", "space gun", "viper strike", "alien blaster", 
		"alien rifle", "rainbow blaster", "hex spitter", "beam launcher", "gatling laser", 
		"tri laser", "techno rifle", "minigun", "flamethrower", "rocket launcher", 
		"golden pistol", "golden rifle", "retribution ray", "candy cane minigun", 
		"pumpkin blaster", "halloween staff", "tree launcher", "fiery cannon", "invader crossbow"
	}
	
	for _, w in ipairs(weapons) do
		if string.find(lower, w) then
			return true
		end
	end
	return false
end

-- Функция честного нажатия на клавишу "1" для выбора первого слота
local function pressKeyOne()
	task.defer(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
		task.wait(0.01)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
	end)
end

-- Функция имитации нажатия Backspace для выброса предмета из рук
local function pressBackspaceToDrop(tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	if tool.Parent ~= character then
		humanoid:EquipTool(tool)
		task.wait(0.1)
	end
	
	if tool.Parent == character then
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
		task.wait(0.02)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
		task.wait(0.1)
	end
end

