-- Плавный цикл проверки
task.spawn(function()
	while true do
		task.wait(0.2)
		
		local backpack = player:FindFirstChild("Backpack")
		if backpack then
			-- 1. Логика Auto-Drop (работает только если включено)
			if autoDropEnabled then
				local foundAnything = false
				
				for _, item in ipairs(character:GetChildren()) do
					if item:IsA("Tool") and matchesTarget(item.Name) then
						pressBackspaceToDrop(item)
						foundAnything = true
					end
				end
				
				for _, item in ipairs(backpack:GetChildren()) do
					if item:IsA("Tool") and matchesTarget(item.Name) then
						pressBackspaceToDrop(item)
						foundAnything = true
					end
				end
				
				if foundAnything then
					pressKeyOne()
				end
			end
			
			-- 2. Логика Auto Equip Slot 1 (работает ТОЛЬКО если кнопка включена в ON)
			if autoEquipEnabled then
				local currentTool = nil
				for _, item in ipairs(character:GetChildren()) do
					if item:IsA("Tool") then
						currentTool = item
						break
					end
				end
				
				if currentTool then
					local name = currentTool.Name
					-- Если в руках НЕ граната и НЕ оружие из 1 слота (например, взял меч/2 слот) — жмем 1
					if not matchesTarget(name) and not isSlot1Weapon(name) then
						pressKeyOne()
					end
				else
					-- Если вообще пусто в руках — нажимаем 1
					pressKeyOne()
				end
			end
		end
	end
end)

-- Кнопка Grab All (подбор)
grabAllButton.MouseButton1Click:Connect(function()
	task.spawn(function()
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj:IsA("Tool") and matchesTarget(obj.Name) then
				local handle = obj:FindFirstChild("Handle")
				if handle then
					local grabPos = hrp.Position + Vector3.new(0, 0.5, 0)
					handle.CFrame = CFrame.new(grabPos)
					task.wait(0.01)
					obj.Parent = player.Backpack
				end
			end
		end
	end)
end)
