-- Services
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local VirtualInputManager = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

player.CharacterAdded:Connect(function(newChar)
	character = newChar
end)

-- Создание графического интерфейса (GUI)
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "ZombieAttackHelperGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- Кнопка 1: Переключатель авто-выброса (Auto-Drop)
local autoDropButton = Instance.new("TextButton")
autoDropButton.Name = "AutoDropButton"
autoDropButton.Size = UDim2.new(0, 200, 0, 50)
autoDropButton.Position = UDim2.new(0, 50, 0, 50)
autoDropButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
autoDropButton.TextColor3 = Color3.fromRGB(255, 255, 255)
autoDropButton.TextSize = 16
autoDropButton.Font = Enum.Font.SourceSansBold
autoDropButton.Text = "Auto-Drop Granade/Molotov: OFF"
autoDropButton.Parent = screenGui

-- Кнопка 2: Grab All
local grabAllButton = Instance.new("TextButton")
grabAllButton.Name = "GrabAllButton"
grabAllButton.Size = UDim2.new(0, 200, 0, 50)
grabAllButton.Position = UDim2.new(0, 50, 0, 110)
grabAllButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
grabAllButton.TextColor3 = Color3.fromRGB(255, 255, 255)
grabAllButton.TextSize = 16
grabAllButton.Font = Enum.Font.SourceSansBold
grabAllButton.Text = "Grab All Granade/Molotov"
grabAllButton.Parent = screenGui

local autoDropEnabled = false

-- Функция проверки имени (ищем гранаты и молотовы)
local function matchesTarget(name)
	local lowerName = string.lower(name)
	if string.find(lowerName, "granade") or string.find(lowerName, "grenade") or string.find(lowerName, "molotov") then
		return true
	end
	return false
end

-- Функция честного нажатия на клавишу "1" для выбора первого слота
local function pressKeyOne()
	task.defer(function()
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.One, false, game)
		task.wait(0.01)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.One, false, game)
	end)
end

-- Функция имитации нажатия Backspace для выброса предмета из рук
local function pressBackspaceToDrop(tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end
	
	-- Достаем предмет в руки, если он в рюкзаке
	if tool.Parent ~= character then
		humanoid:EquipTool(tool)
		task.wait(0.03)
	end
	
	-- Проверяем, что предмет действительно в руках
	if tool.Parent == character then
		VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Backspace, false, game)
		task.wait(0.01)
		VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Backspace, false, game)
		task.wait(0.03)
	end
end

-- Переключатель кнопки Auto-Drop
autoDropButton.MouseButton1Click:Connect(function()
	autoDropEnabled = not autoDropEnabled
	if autoDropEnabled then
		autoDropButton.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
		autoDropButton.Text = "Auto-Drop Granade/Molotov: ON"
	else
		autoDropButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		autoDropButton.Text = "Auto-Drop Granade/Molotov: OFF"
	end
end)

-- Стабильный мониторинг через Heartbeat
RunService.Heartbeat:Connect(function()
	if not autoDropEnabled then return end
	
	local backpack = player:FindFirstChild("Backpack")
	if not backpack then return end
	
	local foundAnything = false
	
	-- Проверяем руки
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") and matchesTarget(item.Name) then
			pressBackspaceToDrop(item)
			foundAnything = true
		end
	end
	
	-- Проверяем рюкзак
	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") and matchesTarget(item.Name) then
			pressBackspaceToDrop(item)
			foundAnything = true
		end
	end
	
	-- Если что-то скинули, нажимаем клавишу "1"
	if foundAnything then
		pressKeyOne()
	end
end)

-- Кнопка Grab All (подбор)
grabAllButton.MouseButton1Click:Connect(function()
	task.spawn(function()
		local hrp = character:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		for _, obj in ipairs(Workspace:GetChildren()) do
			if obj:IsA("Tool") and matchesTarget(obj.Name) then
				local handle = obj:FindFirstChild("Handle")
				if handle then
					local grabPos = hrp.Position + Vector3.new(0, 0.5, 0)
					handle.CFrame = CFrame.new(grabPos)
					task.wait(0.01)
					obj.Parent = player.Backpack
				end
			end
		end
	end)
end)
