local Players = game:GetService("Players")
local VirtualUser = game:GetService("VirtualUser")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()

player.CharacterAdded:Connect(function(newChar)
	character = newChar
end)

-- 1. Создаем ScreenGui через Instance.new
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "AutoToolGui"
screenGui.ResetOnSpawn = false
screenGui.Parent = player:WaitForChild("PlayerGui")

-- 2. Создаем саму кнопку (TextButton)
local button = Instance.new("TextButton")
button.Name = "UseAllToolsButton"
button.Size = UDim2.new(0, 140, 0, 50)
button.Position = UDim2.new(0, 50, 0, 200)
button.BackgroundColor3 = Color3.fromRGB(40, 160, 80)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 16
button.Font = Enum.Font.SourceSansBold
button.Text = "Use All Tools"

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

button.Parent = screenGui

-- 3. Функция использования всех предметов и клика по экрану
local function useAllTools()
	if not character or not character:FindFirstChild("Humanoid") then
		return
	end
	
	local humanoid = character.Humanoid
	local backpack = player:FindFirstChild("Backpack")
	
	local toolsToUse = {}
	
	if backpack then
		for _, item in ipairs(backpack:GetChildren()) do
			if item:IsA("Tool") then
				table.insert(toolsToUse, item)
			end
		end
	end
	
	for _, item in ipairs(character:GetChildren()) do
		if item:IsA("Tool") then
			table.insert(toolsToUse, item)
		end
	end
	
	for _, tool in ipairs(toolsToUse) do
		if tool.Parent == backpack then
			humanoid:EquipTool(tool)
			task.wait(0.05)
		end
		
		if tool.Parent == character then
			tool:Activate()
			
			-- Дополнительно эмулируем клик мыши / нажатие на экран
			pcall(function()
				VirtualUser:Button1Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
				task.wait(0.02)
				VirtualUser:Button1Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
			end)
		end
	end
end

-- 4. Подключаем клик по кнопке
button.MouseButton1Click:Connect(useAllTools)
